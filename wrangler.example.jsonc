{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "your-study-companion",
  "main": "../cloud/worker.mjs",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist-cloud",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "node cloud/build.mjs",
    "cwd": "."
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-study-companion",
      "database_id": "YOUR_DATABASE_ID"
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://your-study-companion.YOUR_SUBDOMAIN.workers.dev",
    "GITHUB_CLIENT_ID": "YOUR_CLIENT_ID",
    "GITHUB_ALLOWED_IDS": "YOUR_NUMERIC_GITHUB_ID"
  }
}
